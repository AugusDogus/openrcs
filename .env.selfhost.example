# Self-hosting with docker-compose.yml. Copy to .env (never commit it).

# The HTTPS address Tailscale Serve gives this node:
# https://<TS_HOSTNAME>.<your-tailnet-name>.ts.net (no trailing slash).
# Find the tailnet name under DNS in the Tailscale admin console.
OPENRCS_URL=https://openrcs.example-tailnet.ts.net

# Tailscale auth key (admin console > Settings > Keys), ideally reusable=off,
# ephemeral=off, pre-tagged with tag:mcp-servers. An OAuth client secret also
# works: append ?ephemeral=false and set TS_EXTRA_ARGS below.
TS_AUTHKEY=

# Name of the node on your tailnet (first label of OPENRCS_URL).
TS_HOSTNAME=openrcs

# Extra `tailscale up` flags, e.g. --advertise-tags=tag:mcp-servers
TS_EXTRA_ARGS=

# Where the database, generated secrets and Tailscale state live on the host.
# Unraid: /mnt/user/appdata/openrcs
OPENRCS_DATA=./data
