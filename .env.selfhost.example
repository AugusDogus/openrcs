# Self-hosting with docker-compose.yml. Copy to .env (never commit it).

# The address Tailscale Serve gives openrcs on this machine, no trailing slash:
# https://<machine>.<your-tailnet>.ts.net:5443 (`tailscale serve status` shows it).
OPENRCS_URL=https://myserver.example-tailnet.ts.net:5443

# Loopback port Serve forwards to.
OPENRCS_PORT=5480

# Where the database and generated secrets live. Unraid: /mnt/user/appdata/openrcs
OPENRCS_DATA=./data
