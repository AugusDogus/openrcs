#!/usr/bin/with-contenv bash
# shellcheck shell=bash
# Runs as root before the Selkies config and the services: resolves the public
# URL, prepares /data and the sign-in browser's RAM-only profile folder, and
# narrows nginx and Selkies to this deployment.
set -euo pipefail

ENV_DIR=/run/s6/container_environment
DATA_DIR=/data
NGINX_CONFIG=/etc/nginx/sites-available/default

# OPENRCS_URL is the Tailscale Serve address people open, such as
# https://myserver.example.ts.net:5443 (openrcs-start refuses to run without it).
if [ -n "${OPENRCS_URL:-}" ]; then
  OPENRCS_URL="${OPENRCS_URL%/}"
  printf '%s' "$OPENRCS_URL" > "$ENV_DIR/OPENRCS_URL"
  # The stream's WebSocket only accepts the openrcs page's origin.
  printf '%s' "$OPENRCS_URL" > "$ENV_DIR/SELKIES_ALLOWED_ORIGINS"
fi

mkdir -p "$DATA_DIR/secrets"
chmod 700 "$DATA_DIR/secrets"
chown abc:abc "$DATA_DIR" "$DATA_DIR/secrets"
find "$DATA_DIR" -maxdepth 1 -name 'openrcs.db*' -exec chown abc:abc {} +
find "$DATA_DIR/secrets" -type f -exec chown abc:abc {} +

# The sign-in browser's profile lives in RAM and starts empty on every boot.
rm -rf /dev/shm/openrcs-browser
install -d -m 700 -o abc -g abc /dev/shm/openrcs-browser

# nginx listens on every interface inside the container. Publish its port on
# the host's loopback only (-p 127.0.0.1:5480:3000) and keep the container on
# its own Docker network: sign-in trusts the Tailscale-User-Login header, so
# only Tailscale Serve on the host may reach it (docs/self-hosting.md).
sed -i "s|OPENRCS_LISTEN|${OPENRCS_BIND:-0.0.0.0}|g" "$NGINX_CONFIG"
