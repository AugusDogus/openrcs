# Copy to .env.local for local development. Never commit real values.

# Public origin of the app, no trailing slash. It is also the OAuth issuer
# and the MCP resource prefix (${BETTER_AUTH_URL}/api/mcp). Over https the
# device cookie is __Host-openrcs-device (Secure); over http://localhost it is
# __openrcs-device.
BETTER_AUTH_URL=http://localhost:3000

# Better Auth signing/encryption secret, at least 32 characters.
# Generate: openssl rand -base64 32
BETTER_AUTH_SECRET=

# GitHub OAuth app (or GitHub App) used for sign-in. Create one at
# https://github.com/settings/developers with the authorization callback URL
# ${BETTER_AUTH_URL}/api/auth/callback/github
# (e.g. http://localhost:3000/api/auth/callback/github for local dev).
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# libSQL database. Local dev: file:./.data/dev.db (created by `bun run db:migrate`).
# Production: libsql://<db>-<org>.turso.io
TURSO_DATABASE_URL=file:./.data/dev.db

# Turso auth token (`turso db tokens create <db>`). Leave empty for file: URLs.
TURSO_AUTH_TOKEN=

# Server key share for the split-key vault (docs/security.md): base64 that
# decodes to exactly 32 bytes. Rotating it makes every key slot and access
# token unusable (users re-pair and re-authorize MCP clients).
# Generate: openssl rand -base64 32
KEY_PEPPER=
