# Copy to .env.local for `next dev`. Never commit real values. The container
# sets all of these itself (docs/self-hosting.md).

# Public origin of the app, no trailing slash. It is also the OAuth issuer
# and the MCP resource prefix (${BETTER_AUTH_URL}/api/mcp).
BETTER_AUTH_URL=http://localhost:3000

# Better Auth signing secret, at least 32 characters.
# Generate: openssl rand -base64 32
BETTER_AUTH_SECRET=

# libSQL database (created by `bun run db:migrate`).
DATABASE_URL=file:./.data/dev.db

# Server key that every user's data key is wrapped under (docs/security.md):
# base64 that decodes to exactly 32 bytes. Rotating it makes stored messages,
# refresh tokens and access tokens unusable (re-pair and re-authorize agents).
# Generate: openssl rand -base64 32
KEY_PEPPER=
