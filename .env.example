# Copy to .env.local for local development. Never commit real values.
# Generate secrets with: openssl rand -base64 32

# Public origin of the app, no trailing slash. Also the OAuth issuer base
# (issuer is ${BETTER_AUTH_URL}/api/auth) and the MCP resource prefix
# (${BETTER_AUTH_URL}/api/mcp).
BETTER_AUTH_URL=http://localhost:3000

# Better Auth signing/encryption secret, at least 32 characters.
BETTER_AUTH_SECRET=

# libSQL database. Local dev: file:./.data/dev.db (created by `bun run db:migrate`).
# Production: libsql://<db>-<org>.turso.io
TURSO_DATABASE_URL=file:./.data/dev.db

# Turso auth token (`turso db tokens create <db>`). Leave empty for file: URLs.
TURSO_AUTH_TOKEN=

# AES-256-GCM key for secrets at rest (Google cookies, pairing keys).
# Must be base64 that decodes to exactly 32 bytes. Rotating it makes stored
# pairings unreadable (users re-pair).
SESSION_ENCRYPTION_KEY=

# Comma-separated sign-up allowlist (case-insensitive).
ALLOWED_EMAILS=you@example.com

# Bearer secret Vercel Cron sends to cron endpoints, at least 16 characters.
CRON_SECRET=
